{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?17bath\\.org"
        }
      ],
      "destination": "/shower",
      "permanent": false
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?17bath\\.org"
        }
      ],
      "destination": "/robots-bath.txt",
      "permanent": false
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?17bath\\.org"
        }
      ],
      "destination": "/sitemap-bath.xml",
      "permanent": false
    },
    {
      "source": "/llms.txt",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?17bath\\.org"
        }
      ],
      "destination": "/llms-bath.txt",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/booking",
      "destination": "/booking.html"
    },
    {
      "source": "/lamps",
      "destination": "/lamps.html"
    },
    {
      "source": "/blessing",
      "destination": "/blessing.html"
    },
    {
      "source": "/urgent",
      "destination": "/urgent.html"
    },
    {
      "source": "/checkin",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?17bath\\.org"
        }
      ],
      "destination": "/index.html"
    },
    {
      "source": "/relocation",
      "destination": "/relocation.html"
    },
    {
      "source": "/donation",
      "destination": "/donation.html"
    },
    {
      "source": "/deities",
      "destination": "/deities.html"
    },
    {
      "source": "/scripture",
      "destination": "/scripture.html"
    },
    {
      "source": "/calendar",
      "destination": "/calendar.html"
    },
    {
      "source": "/shower",
      "destination": "/shower.html"
    },
    {
      "source": "/bulletins",
      "destination": "/bulletins.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "_comment": "圖片代理。必須排在萬用規則之前，否則 /si/... 會被導成 index.html。見 api/si.ts：Supabase Storage 對每個公開檔案都送 X-Robots-Tag: none，等同 noindex，圖片永遠進不了 Google。",
      "source": "/si/(.*)",
      "destination": "/api/si?p=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 1 * * *"
    }
  ]
}
