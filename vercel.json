{
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/booking",
      "destination": "/booking.html"
    },
    {
      "source": "/lamps",
      "destination": "/lamps.html"
    },
    {
      "source": "/blessing",
      "destination": "/blessing.html"
    },
    {
      "source": "/urgent",
      "destination": "/urgent.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "(www\\.)?17bath\\.org" }],
      "destination": "/shower.html"
    },
    {
      "source": "/checkin",
      "has": [{ "type": "host", "value": "(www\\.)?17bath\\.org" }],
      "destination": "/index.html"
    },
    {
      "source": "/relocation",
      "destination": "/relocation.html"
    },
    {
      "source": "/deities",
      "destination": "/deities.html"
    },
    {
      "source": "/scripture",
      "destination": "/scripture.html"
    },
    {
      "source": "/calendar",
      "destination": "/calendar.html"
    },
    {
      "source": "/shower",
      "destination": "/shower.html"
    },
    {
      "source": "/bulletins",
      "destination": "/bulletins.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 1 * * *"
    }
  ]
}
